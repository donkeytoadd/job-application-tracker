        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.30" />
